# This .gitignore is appropriate for repositories deployed to GitHub Pages and using
# a Gemfile as specified at https://github.com/github/pages-gem#conventional

# Basic Jekyll gitignores (synchronize to Jekyll.gitignore)
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Additional Ruby/bundler ignore for when you run: bundle install
/vendor

# Specific ignore for GitHub Pages
# GitHub Pages will always use its own deployed version of pages-gem
# This means GitHub Pages will NOT use your Gemfile.lock and therefore it is
# counterproductive to check this file into the repository.
# Details at https://github.com/github/pages-gem/issues/768
Gemfile.lock

*.DS_Store
.DS_Store

/.quarto/

**/*.quarto_ipynb

# Source archive: original Word/PowerPoint assignments and guides.
# Kept locally for reference, never committed - the repo is public and these
# files contain real client, student and respondent data.
Prior Assignments/

# Python bytecode from the tools/ generator scripts
__pycache__/

# Rendered output that lands next to the source .qmd files. Quarto normally
# moves these into _site/, but an interrupted or failed render leaves them
# behind. The real build is _site/; nothing here should ever be committed.
#
# NOTE: the .pdf/.docx/.rtf patterns are deliberately scoped to the directories
# that hold .qmd files. assignments/files/ holds the templates students
# download and must NOT be caught by them.
*.html
*.tex
*.aux
*.log

/*.pdf
/*.docx
/*.rtf

/assignments/*.pdf
/assignments/*.docx
/assignments/*.rtf

/guidelines/*.pdf
/guidelines/*.docx
/guidelines/*.rtf
